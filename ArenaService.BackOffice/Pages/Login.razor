@page "/login"
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration
@using Microsoft.Extensions.Configuration
@using ArenaService.BackOffice.Options
@using System.Text

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card mt-5">
                <div class="card-header">
                    <h3 class="text-center">로그인</h3>
                </div>
                <div class="card-body">
                    <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                        <DataAnnotationsValidator />
                        <div class="form-group">
                            <label for="username">사용자명:</label>
                            <InputText id="username" class="form-control" @bind-Value="loginModel.Username" />
                        </div>
                        <div class="form-group mt-3">
                            <label for="password">비밀번호:</label>
                            <InputText id="password" type="password" class="form-control" @bind-Value="loginModel.Password" />
                        </div>
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger mt-3">
                                @errorMessage
                            </div>
                        }
                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-primary">로그인</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string errorMessage = string.Empty;

    private class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private void HandleLogin()
    {
        var config = Configuration.GetSection(BasicAuthOptions.SectionName).Get<BasicAuthOptions>();

        if (loginModel.Username == config?.Username && loginModel.Password == config?.Password)
        {
            var credentials = Convert.ToBase64String(Encoding.UTF8.GetBytes($"{loginModel.Username}:{loginModel.Password}"));
            // Store credentials in localStorage or other state management
            NavigationManager.NavigateTo("/");
        }
        else
        {
            errorMessage = "잘못된 사용자명 또는 비밀번호입니다.";
        }
    }
} 